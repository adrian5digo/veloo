# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Publishable key (sb_publishable_…) o la "anon" legacy. Va al navegador: es pública.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) o la "service_role" legacy. SOLO servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Dominio de los perfiles públicos ([usuario].veloo.vip). Vacío en desarrollo: se usa /u/[usuario].
NEXT_PUBLIC_DOMINIO=
# URL del sitio, para links de correo cuando la petición no trae "origin".
NEXT_PUBLIC_SITIO_URL=http://localhost:3100
# Solo desarrollo: "1" activa el procesador de pagos simulado (no cobra). Nunca funciona en producción.
PAGOS_SIMULADOS=
# SPEI manual (validación sin procesador): el fan transfiere a esta cuenta con un concepto único y el
# equipo confirma cada pago en /panel/pagos. Con las dos llenas y PAGOS_SIMULADOS vacío, es el único método.
SPEI_CLABE=
# Nombre tal como lo muestra el banco al transferir; el fan lo compara antes de enviar.
SPEI_TITULAR=
# Stripe: sk_test_ para pruebas; sk_live_ habilita cobros reales solo por set de la cuenta piloto.
# Los paquetes de tokens permanecen disponibles únicamente con llave de prueba.
# Checkout alojado no necesita una llave pública pk_ en la aplicación.
STRIPE_SECRET_KEY=
# Firma del webhook /api/stripe/webhook, del mismo modo (prueba o real) que la llave.
# Eventos: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed y checkout.session.expired.
# En local: stripe listen --forward-to localhost:3100/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Llave pública VAPID para avisos web push (P3). Vacía = los avisos se muestran como "todavía no disponibles".
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Cron de renovación de suscripciones (/api/cron/suscripciones). Vercel lo manda como "Authorization: Bearer …".
# Genera uno largo y aleatorio (ej. openssl rand -hex 32).
CRON_SECRET=
# Resend (correo transaccional): avisos de set nuevo, mensajes, desbloqueos, tokens y suscripciones.
# Sin la llave no se manda nada (desarrollo): se escribe en la consola qué se habría mandado.
RESEND_API_KEY=
# Remitente con un dominio verificado en Resend.
CORREO_REMITENTE=Veloo <hola@veloo.vip>
# Firma los links de baja (largo y aleatorio, ej. openssl rand -hex 32). No cambiarlo: invalida los links ya enviados.
CORREO_SECRETO=
